{
	"manifest_version": 3,
	"name": "Pin Sniper",
	"version": "3.0",
	"description": "Downloads boards, Images, GIFs, & Videos from Pinterest.",
	"permissions": [
		"activeTab",
		"scripting",
		"downloads",
		"declarativeNetRequest"
	],
	"host_permissions": [
		"*://*.pinimg.com/*",
		"*://*.pinterest.com/*",
		"http://127.0.0.1:31337/*"
	],
	"icons": {
		"16": "icon.png",
		"48": "icon.png",
		"128": "icon.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icon.png",
			"48": "icon.png",
			"128": "icon.png"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"declarative_net_request": {
		"rule_resources": [
			{
				"id": "cors_bypass",
				"enabled": true,
				"path": "rules.json"
			}
		]
	},
	"content_scripts": [
		{
			"matches": [ "*://*.pinterest.com/*" ],
			"js": [ "hls.min.js" ]
		}
	]
}